{
  "components": {
    "schemas": {
      "AddNoteCall": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/AddNoteInput"
          },
          "name": {
            "const": "add_note",
            "default": "add_note",
            "title": "Name",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AddNoteOutput"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "input"
        ],
        "title": "AddNoteCall",
        "type": "object"
      },
      "AddNoteInput": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "AddNoteInput",
        "type": "object"
      },
      "AddNoteOutput": {
        "additionalProperties": false,
        "properties": {
          "line": {
            "title": "Line",
            "type": "string"
          },
          "written": {
            "title": "Written",
            "type": "boolean"
          }
        },
        "required": [
          "written",
          "line"
        ],
        "title": "AddNoteOutput",
        "type": "object"
      },
      "AgentRequest": {
        "additionalProperties": false,
        "description": "One turn on a thread: a new user message, or a confirmation decision.",
        "examples": [
          {
            "max_tool_calls": 5,
            "message": "What is new in Python 3.14?"
          },
          {
            "confirm": true,
            "thread_id": "6f1c2a9e-4b7d-4e2a-9c1f-3d5e8a7b2c10"
          }
        ],
        "properties": {
          "confirm": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Approve (true) or reject (false) the pending action. Only valid while the thread is awaiting confirmation.",
            "title": "Confirm"
          },
          "max_tool_calls": {
            "default": 5,
            "description": "Most tool calls this request may make.",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Tool Calls",
            "type": "integer"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's message, 1-4000 characters. Exactly one of message and confirm must be set.",
            "title": "Message"
          },
          "thread_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Thread to continue. Omit to start a new thread.",
            "title": "Thread Id"
          }
        },
        "title": "AgentRequest",
        "type": "object"
      },
      "AgentResponse": {
        "additionalProperties": false,
        "description": "The result of one run. Which fields are set depends on `status`.",
        "examples": [
          {
            "answer": "Noted: buy milk.",
            "status": "ok",
            "thread_id": "6f1c2a9e-4b7d-4e2a-9c1f-3d5e8a7b2c10",
            "tool_calls": [
              {
                "id": "call-1",
                "input": {
                  "text": "buy milk"
                },
                "name": "add_note",
                "output": {
                  "line": "2026-10-15T09:30:00Z\tbuy milk",
                  "written": true
                }
              }
            ]
          },
          {
            "status": "truncated",
            "thread_id": "6f1c2a9e-4b7d-4e2a-9c1f-3d5e8a7b2c10",
            "tool_calls": []
          },
          {
            "error": {
              "code": "model_output_invalid",
              "message": "the model gave no answer"
            },
            "status": "error",
            "thread_id": "6f1c2a9e-4b7d-4e2a-9c1f-3d5e8a7b2c10",
            "tool_calls": []
          },
          {
            "pending_action": {
              "input": {
                "text": "buy milk"
              },
              "tool": "add_note"
            },
            "status": "awaiting_confirmation",
            "thread_id": "6f1c2a9e-4b7d-4e2a-9c1f-3d5e8a7b2c10",
            "tool_calls": []
          }
        ],
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The answer when status is ok; may hold a partial answer when truncated; otherwise null.",
            "title": "Answer"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "What went wrong; set only when status is error."
          },
          "pending_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingAction"
              },
              {
                "type": "null"
              }
            ],
            "description": "The action waiting for confirmation; set only when status is awaiting_confirmation."
          },
          "status": {
            "description": "How the run ended.",
            "enum": [
              "ok",
              "truncated",
              "error",
              "awaiting_confirmation"
            ],
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "description": "The thread, new or continued.",
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          },
          "tool_calls": {
            "default": [],
            "description": "Tool calls made in this request, in order.",
            "items": {
              "discriminator": {
                "mapping": {
                  "add_note": "#/components/schemas/AddNoteCall",
                  "fetch_site": "#/components/schemas/FetchSiteCall",
                  "web_search": "#/components/schemas/WebSearchCall"
                },
                "propertyName": "name"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WebSearchCall"
                },
                {
                  "$ref": "#/components/schemas/FetchSiteCall"
                },
                {
                  "$ref": "#/components/schemas/AddNoteCall"
                }
              ]
            },
            "title": "Tool Calls",
            "type": "array"
          }
        },
        "required": [
          "thread_id",
          "status"
        ],
        "title": "AgentResponse",
        "type": "object"
      },
      "ApiError": {
        "additionalProperties": false,
        "description": "Body of a 409 or 503 response (SPEC-0002, SPEC-0007 B-0004).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApiErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "thread_busy",
              "dependency_unavailable"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorDetail",
        "type": "object"
      },
      "ErrorInfo": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "model_output_invalid",
              "internal"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo",
        "type": "object"
      },
      "FetchSiteCall": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/FetchSiteInput"
          },
          "name": {
            "const": "fetch_site",
            "default": "fetch_site",
            "title": "Name",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FetchSiteOutput"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "input"
        ],
        "title": "FetchSiteCall",
        "type": "object"
      },
      "FetchSiteInput": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "FetchSiteInput",
        "type": "object"
      },
      "FetchSiteOutput": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 1000,
            "title": "Text",
            "type": "string"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "text",
          "truncated"
        ],
        "title": "FetchSiteOutput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "PendingAction": {
        "additionalProperties": false,
        "description": "A side-effecting tool call waiting for human confirmation (SPEC-0001 B-0005).",
        "properties": {
          "input": {
            "$ref": "#/components/schemas/AddNoteInput"
          },
          "tool": {
            "const": "add_note",
            "default": "add_note",
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "input"
        ],
        "title": "PendingAction",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "description": "Structured tool failure returned to the model (SPEC-0003 B-0001).",
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "timeout",
              "upstream_error",
              "rejected",
              "internal"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebSearchCall": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/WebSearchInput"
          },
          "name": {
            "const": "web_search",
            "default": "web_search",
            "title": "Name",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WebSearchOutput"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "input"
        ],
        "title": "WebSearchCall",
        "type": "object"
      },
      "WebSearchInput": {
        "additionalProperties": false,
        "properties": {
          "max_results": {
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Max Results",
            "type": "integer"
          },
          "query": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "WebSearchInput",
        "type": "object"
      },
      "WebSearchOutput": {
        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/WebSearchResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "WebSearchOutput",
        "type": "object"
      },
      "WebSearchResult": {
        "additionalProperties": false,
        "properties": {
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "snippet"
        ],
        "title": "WebSearchResult",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A LangGraph agent with three tools (web search, fetch a page, add a note) behind one endpoint. Every response is a validated `AgentResponse`; conversation state is kept per thread in Redis, and side-effecting tools wait for confirmation. Behavior is specified in [the specs](https://github.com/darrenpaine/harnessd/blob/main/docs/specs/README.md).",
    "title": "harnessd",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns ok without calling Redis or the LLM provider.",
        "operationId": "health_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check the service is up",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/agent/run": {
      "post": {
        "description": "Send a user message, or confirm or reject a pending action, and run the agent until it answers, hits the tool-call limit, fails, or needs confirmation. Every completed run returns 200 whatever its `status`.",
        "operationId": "run_agent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "A run is in progress on the thread."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Redis or the LLM provider is down."
          }
        },
        "summary": "Run the agent on a thread",
        "tags": [
          "agent"
        ]
      }
    }
  }
}
