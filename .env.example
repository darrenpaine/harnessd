# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Model provider: ollama (local default) | anthropic | google | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-6.1-terra
# Calls always go to OpenAI's API; OPENAI_API_BASE and OPENAI_BASE_URL are ignored.
OPENAI_API_KEY=
# Pace model calls to a provider quota, e.g. a free tier's requests per minute
# (SPEC-0001 B-0008). Unset: no pacing.
# LLM_REQUESTS_PER_MINUTE=15

# Injection screen (SPEC-0012 B-0005, B-0006): off (default) | ollama-systemone | chat
# INJECTION_SCREEN=ollama-systemone
# Required when the screen is on: nimble for ollama-systemone, or a chat model of
# LLM_PROVIDER for chat.
# INJECTION_SCREEN_MODEL=nimble
# Tool output at or above this probability of an injection is withheld.
# INJECTION_THRESHOLD=0.8
# When the screen fails: withhold (fail closed) or allow (fail open).
# INJECTION_SCREEN_ON_ERROR=withhold

# Token budgets (SPEC-0012 B-0009, B-0014). The run budget can't be larger than
# the thread budget. A thread over its budget must be compacted or deleted.
# MAX_TOKENS_PER_RUN=50000
# MAX_TOKENS_PER_THREAD=200000

# Daily cost limit in USD across all threads (SPEC-0012 B-0010, B-0011); unset = no
# limit. When set, the chat model needs a price in src/agent/prices.py (Ollama is
# free). Runs and compactions then get 429 until 00:00 UTC once it is reached.
# DAILY_COST_LIMIT_USD=5

# Tools
TAVILY_API_KEY=
NOTES_PATH=data/notes.txt
# Host folder for notes (docker compose only; NOTES_PATH is ignored there);
# default ./data/notes
# NOTES_DIR=/path/to/notes
# The app container runs as this user and group, which must be able to write
# NOTES_DIR (default 1000:1000; `id -u` and `id -g` give yours).
# APP_UID=1000
# APP_GID=1000

# Runtime
REDIS_URL=redis://localhost:6379
# Host folder for Redis data (docker compose only); default ./data/redis
# REDIS_DATA_DIR=/path/to/redis-data
RUN_TIMEOUT_SECONDS=60
CHECKPOINT_TTL_HOURS=24
LOG_LEVEL=info
# text (default) or json: one JSON object per line
LOG_FORMAT=text

# Tracing (SPEC-0010): off by default. `make langfuse` starts a local Langfuse;
# create a project there and copy its keys here.
TRACING_ENABLED=false
LANGFUSE_HOST=http://localhost:5998
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# To send traces to another OTLP backend instead, set these (they win over Langfuse):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ...
# Prompts, replies and tool data are recorded on spans. Set false in shared deployments.
TRACE_CONTENT=true

# Evals (SPEC-0011): `make evals` runs every case this many times.
EVAL_REPEATS=3
# A full run fails when its score is more than this many points below the baseline.
EVAL_REGRESSION_POINTS=5
