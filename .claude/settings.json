{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_branch_merged.py\"",
            "timeout": 60,
            "statusMessage": "Checking the branch's PR is merged"
          }
        ]
      }
    ]
  }
}
